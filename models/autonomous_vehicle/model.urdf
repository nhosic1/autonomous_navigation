<?xml version="1.0" ?>
<robot name="autonomous_vehicle">
  <!-- materials section -->
  <material name="offwhite">
    <color rgba="1.0 1.0 0.8941176470588236 1.0" />
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- links section -->
  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <geometry>
        <box size="0.7 0.32 0.12"/>
      </geometry>
      <material name="offwhite"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.7 0.35 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15"/>
      <inertia ixx="0.1711" ixy="0.0" ixz="0.0" iyy="0.6305" iyz="0.0" izz="0.7656"/>
    </inertial>
  </link>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.0033" ixy="0.0" ixz="0.0" iyy="0.0033" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <gazebo reference="front_left_wheel">
    <mu1>0.4</mu1>
    <mu2>0.9</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.0033" ixy="0.0" ixz="0.0" iyy="0.0033" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <gazebo reference="front_right_wheel">
    <mu1>0.4</mu1>
    <mu2>0.9</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.0033" ixy="0.0" ixz="0.0" iyy="0.0033" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <gazebo reference="rear_left_wheel">
    <mu1>0.4</mu1>
    <mu2>0.9</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.0033" ixy="0.0" ixz="0.0" iyy="0.0033" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <gazebo reference="rear_right_wheel">
    <mu1>0.4</mu1>
    <mu2>0.9</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <link name="front_left_wheel_steering_link">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000175" ixy="0.0" ixz="0.0" iyy="0.0000175" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <link name="front_right_wheel_steering_link">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000175" ixy="0.0" ixz="0.0" iyy="0.0000175" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <link name="front_axle">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
      <geometry>
        <cylinder length="0.44" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0113" ixy="0.0" ixz="0.0" iyy="0.0113" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="rear_axle">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
      <geometry>
        <cylinder length="0.52" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0113" ixy="0.0" ixz="0.0" iyy="0.0113" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="stereo_camera_holder">
    <visual>
      <geometry>
        <box size="0.04 0.25 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.25 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0113" ixy="0.0" ixz="0.0" iyy="0.0113" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="left_camera">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0113" ixy="0.0" ixz="0.0" iyy="0.0113" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="left_camera">
    <sensor name="left_camera" type="camera">
      <camera>
        <horizontal_fov>1.1519</horizontal_fov>
        <image>
          <width>768</width>
          <height>432</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <link name="right_camera">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0113" ixy="0.0" ixz="0.0" iyy="0.0113" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="right_camera">
    <sensor name="right_camera" type="camera">
      <camera>
        <horizontal_fov>1.1519</horizontal_fov>
        <image>
          <width>768</width>
          <height>432</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- joints section -->
  <joint name="dummy_base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <joint name="front_left_wheel_steering_joint" type="revolute">
    <origin xyz="0 0.22 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="25" lower="-0.6" upper="0.6" velocity="1.0"/>
    <parent link="front_axle"/>
    <child link="front_left_wheel_steering_link"/>
  </joint>

  <joint name="front_right_wheel_steering_joint" type="revolute">
    <origin xyz="0 -0.22 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="25" lower="-0.6" upper="0.6" velocity="1.0"/>
    <parent link="front_axle"/>
    <child link="front_right_wheel_steering_link"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0 0.04 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="front_left_wheel_steering_link"/>
    <child link="front_left_wheel"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0 -0.04 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="front_right_wheel_steering_link"/>
    <child link="front_right_wheel"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="revolute">
    <origin xyz="0 -0.26 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="25" lower="-3.1416" upper="3.1416" velocity="10.0"/>
    <parent link="rear_axle"/>
    <child link="rear_left_wheel"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="0 0.26 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="rear_axle"/>
    <child link="rear_right_wheel"/>
  </joint>

  <joint name="front_axle_joint" type="fixed">
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="front_axle"/>
  </joint>

  <joint name="rear_axle_joint" type="fixed">
    <origin xyz="-0.3 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="rear_axle"/>
  </joint>

  <joint name="stereo_camera_holder_joint" type="fixed">
    <origin xyz="0.3 0 0.25" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="stereo_camera_holder"/>
  </joint>

  <joint name="left_camera_joint" type="fixed">
    <origin xyz="0.02 0.09 0" rpy="0 0 0"/>
    <parent link="stereo_camera_holder"/>
    <child link="left_camera"/>
  </joint>

  <joint name="right_camera_joint" type="fixed">
    <origin xyz="0.02 -0.09 0" rpy="0 0 0"/>
    <parent link="stereo_camera_holder"/>
    <child link="right_camera"/>
  </joint>

  <!-- plugins section -->
  <!-- <gazebo>
    <plugin
      filename="libignition-gazebo-odometry-publisher-system.so"
      name="ignition::gazebo::systems::OdometryPublisher">
      <xyz_offset>-0.957138 0 -0.025 0 0 0</xyz_offset>
      <odom_publish_frequency>15</odom_publish_frequency>
    </plugin>
  </gazebo> -->

  <!-- <plugin
    filename="libignition-gazebo-joint-state-publisher-system.so"
    name="ignition::gazebo::systems::JointStatePublisher">
    <joint_name>front_left_wheel_steering_joint</joint_name>
    <joint_name>front_right_wheel_steering_joint</joint_name>
    <joint_name>rear_left_wheel_joint</joint_name>
    <joint_name>rear_right_wheel_joint</joint_name>
  </plugin> -->

  <!-- <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>front_left_wheel_steering_joint</joint_name>
      <p_gain>1</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>2.5</d_gain>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>front_right_wheel_steering_joint</joint_name>
      <p_gain>1</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>2.5</d_gain>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-controller-system.so"
      name="ignition::gazebo::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <initial_velocity>0.5</initial_velocity>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-controller-system.so"
      name="ignition::gazebo::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <initial_velocity>0.5</initial_velocity>
    </plugin>
  </gazebo> -->

  <gazebo>
    <plugin
      filename="ignition-gazebo-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <!-- <left_joint>front_left_wheel_joint</left_joint> -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <!-- <right_joint>front_right_wheel_joint</right_joint> -->
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>0.44</kingpin_width>
      <steering_limit>0.4</steering_limit>
      <wheel_base>0.6</wheel_base>
      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <min_velocity>-1</min_velocity>
      <max_velocity>1</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
    </plugin>
  </gazebo>
</robot>