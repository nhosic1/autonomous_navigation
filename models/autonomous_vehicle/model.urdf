<?xml version="1.0" ?>
<robot name="autonomous_vehicle">
  <!-- materials section -->
  <material name="offwhite">
    <color rgba="1.0 1.0 0.8941176470588236 1.0"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="aquablue">
    <color rgba="0.00784313725490196 0.8470588235294118 0.9137254901960784 1.0"/>
  </material>

  <!-- links section -->
  <link name="base_footprint"/>
  <link name="base_link"/>

